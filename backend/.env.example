# Habitopia backend environment variables.
# Copy to .env and fill in real values.

# Path to your Firebase Admin service account JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Required: shared secret for the nightly-reset cron endpoint.
# POST /realms/nightly-reset?secret=<value> must include this exact value.
CRON_SECRET=

# Optional: GitHub personal access token. Raises the search-commits rate limit
# from 10 to 30 requests per minute.
GITHUB_TOKEN=

# Optional: LeetCode session cookie if/when needed by future integrations.
LEETCODE_SESSION_COOKIE=

# Strava OAuth credentials (required for Strava habit integration).
# Get these from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
